# Public values supplied by the Supabase project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key

# Canonical origin used in authentication confirmation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Explicit deployment identity. Remote environments must use staging or
# production; production remains locked until Stripe live mode is audited.
YAQEEN_ENVIRONMENT=local
YAQEEN_RELEASE_SHA=

# Stripe sandbox only. Live keys are intentionally rejected by this build.
STRIPE_TEST_CHECKOUT_ENABLED=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Server-only key used exclusively by trusted payment and webhook boundaries.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-or-hosted-service-role-key

# Server-only token protecting the deep readiness endpoint. Generate at least
# 32 random characters; never prefix it with NEXT_PUBLIC_.
YAQEEN_HEALTHCHECK_TOKEN=
