# Public values supplied by the Supabase project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-hosted-publishable-key

# Canonical origin used in authentication confirmation links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe sandbox only. Live keys are intentionally rejected by this build.
STRIPE_TEST_CHECKOUT_ENABLED=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Server-only key used exclusively by trusted payment and webhook boundaries.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-or-hosted-service-role-key

# Distributed abuse controls. Keep disabled for local work without Redis; every
# staging/production release must set these and turn the gate on.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REDIS_REST_URL=https://replace-me.upstash.io
RATE_LIMIT_REDIS_REST_TOKEN=replace-with-server-only-token
RATE_LIMIT_HMAC_PEPPER=replace-with-at-least-32-random-characters

# Vercel overwrites x-vercel-forwarded-for. For another trusted reverse proxy,
# use "custom" and set the exact header that proxy overwrites.
TRUSTED_PROXY_MODE=vercel
# TRUSTED_PROXY_IP_HEADER=x-your-team-connecting-ip
